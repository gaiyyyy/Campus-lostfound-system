# Frontend environment example for Vite (do NOT commit secrets)
# Copy to `.env` and fill real values locally (prefixed with VITE_ to be exposed to the client)

# Backend API base URL
# Leave empty to use same-origin `/api` requests.
VITE_API_BASE_URL=

# Vite dev server proxy target for `/api` when running inside Docker Compose.
VITE_API_PROXY_TARGET=http://backend:8080

# Optional: public tokens/keys used by client-side services (replace with YOUR values)
# Keep secrets that must remain private on the server side only — do not put them here.
VITE_ANALYTICS_KEY=
VITE_MAP_API_KEY=

# Example: a public API key (if your app needs a public key)
# VITE_PUBLIC_API_KEY=
